{
  "expo": {
    "name": "StamFree",
    "slug": "StamFree",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stamfree",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Snake Sound Trail uses speech recognition to animate the snake as you speak.",
        "NSMicrophoneUsageDescription": "Snake Sound Trail needs your microphone so the snake can hear you and move."
      },
      "bundleIdentifier": "com.stamfree.app"
    },
    "android": {
      "package": "com.stamfree.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1afbc199-22bb-4680-967b-2e63aa88f103"
      }
    }
  }
}
